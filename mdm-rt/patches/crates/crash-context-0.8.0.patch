diff --git a/src/windows.rs b/src/windows.rs
index 076a6b3..5ae6886 100644
--- a/src/windows.rs
+++ b/src/windows.rs
@@ -239,6 +239,55 @@ cfg_if::cfg_if! {
             pub Wcr: [u32; 2],
             pub Wvr: [u64; 2],
         }
+    } else if #[cfg(target_arch = "arm")] {
+        // MDM RT: 32-bit Arm (Windows RT 8.1, Windows 10 on the Surface RT and 2), winnt.h's
+        // _CONTEXT for _ARM_: 0x1A0 bytes, 8-byte aligned.
+        #[repr(C)]
+        #[derive(Clone, Copy)]
+        pub struct NEON128 {
+            pub Low: u64,
+            pub High: i64,
+        }
+
+        #[repr(C)]
+        pub union CONTEXT_0 {
+            pub Q: [NEON128; 16],
+            pub D: [u64; 32],
+            pub S: [u32; 32],
+        }
+
+        #[repr(C, align(8))]
+        pub struct CONTEXT {
+            pub ContextFlags: u32,
+            pub R0: u32,
+            pub R1: u32,
+            pub R2: u32,
+            pub R3: u32,
+            pub R4: u32,
+            pub R5: u32,
+            pub R6: u32,
+            pub R7: u32,
+            pub R8: u32,
+            pub R9: u32,
+            pub R10: u32,
+            pub R11: u32,
+            pub R12: u32,
+            pub Sp: u32,
+            pub Lr: u32,
+            pub Pc: u32,
+            pub Cpsr: u32,
+            pub Fpscr: u32,
+            pub Padding: u32,
+            pub Anonymous: CONTEXT_0,
+            pub Bvr: [u32; 8],
+            pub Bcr: [u32; 8],
+            pub Wvr: [u32; 1],
+            pub Wcr: [u32; 1],
+            pub Padding2: [u32; 2],
+        }
+
+        const _: () = assert!(std::mem::size_of::<CONTEXT>() == 0x1A0);
+        const _: () = assert!(std::mem::align_of::<CONTEXT>() == 8);
     }
 }
 
