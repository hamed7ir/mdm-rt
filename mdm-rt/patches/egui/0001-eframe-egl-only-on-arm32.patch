diff --git a/crates/eframe/Cargo.toml b/crates/eframe/Cargo.toml
index 9a8ab7d..56e504c 100644
--- a/crates/eframe/Cargo.toml
+++ b/crates/eframe/Cargo.toml
@@ -178,11 +178,15 @@ egui-wgpu = { workspace = true, optional = true, features = [
 ] } # if wgpu is used, use it with winit
 pollster = { workspace = true, optional = true } # needed for wgpu
 
+glutin = { workspace = true, optional = true, default-features = false, features = ["egl"] }
+glutin-winit = { workspace = true, optional = true, default-features = false, features = ["egl"] }
+
+# MDM RT: WGL only where Windows has OpenGL. Windows RT (32-bit Arm) has no opengl32.dll, and glutin's WGL links
+# it (glutin_wgl_sys), so the program would not start there: 32-bit Arm draws through EGL only (ANGLE's libEGL).
+# `--cfg mdm_rt_angle` does the same on x86/x64 (MDM RT's x86 test build of the ARM32 drawing path).
+[target.'cfg(all(not(target_arch = "wasm32"), not(target_arch = "arm"), not(mdm_rt_angle)))'.dependencies]
 glutin = { workspace = true, optional = true, default-features = false, features = ["egl", "wgl"] }
-glutin-winit = { workspace = true, optional = true, default-features = false, features = [
-  "egl",
-  "wgl",
-] }
+glutin-winit = { workspace = true, optional = true, default-features = false, features = ["egl", "wgl"] }
 
 # mac:
 [target.'cfg(any(target_os = "macos"))'.dependencies]
